{title: I Won't Let Go}
{artist: Arimaya}
{year: 2019}
{key: C}
{time: 4/4}

{define: C base-fret 1 frets 0 0 0 3}
{define: F base-fret 1 frets 2 0 1 0}
{define: Am base-fret 1 frets 2 0 0 0}
{define: G base-fret 1 frets 0 2 3 2}

