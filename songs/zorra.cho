{title: Zorra}
{artist: Dermis Tatú}
{year: 1995}
{key: Gm}
{time: 4/4}

{define: Gm base-fret 1 frets 0 2 3 1}
{define: C#7 base-fret 4 frets 1 2 1 1}
{define: Bb7 base-fret 1 frets 1 2 1 1}
{define: F base-fret 1 frets 2 0 1 0}
{define: C base-fret 1 frets 0 0 0 3}
{define: Bb base-fret 1 frets 3 2 1 1}
{define: Eb base-fret 1 frets 0 3 3 1}

