{title: Ladrón de tu amor}
{artist: Gualberto Ibarreto}
{year: 1984}
{key: Am}
{time: 4/4}
{capo: 1}

{define: A7 base-fret 1 frets 0 1 0 0}
{define: Dm base-fret 1 frets 2 2 1 0}
