{title: Estoy buscando algo en el Caribe}
{artist: Desorden Público}
{year: 1990}
{key: G}
{time: 4/4}

{define: Gsus4 base-fret 1 frets 0 2 3 3}
{define: G base-fret 1 frets 0 2 3 2}
{define: Bb base-fret 1 frets 3 2 1 1}
{define: F7 base-fret 1 frets 2 3 1 0}
{define: C base-fret 1 frets 0 0 0 3}
{define: A base-fret 1 frets 2 1 0 0}
{define: D base-fret 1 frets 2 2 2 0}
{define: Eb base-fret 1 frets 0 3 3 1}
