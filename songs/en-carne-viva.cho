{title: En carne viva}
{artist: Scarlett Linares}
{year: 2003}
{key: Em}
{time: 6/8}

{define: G base-fret 1 frets 0 2 3 2}
{define: Am base-fret 1 frets 2 0 0 0}
{define: B7 base-fret 1 frets 4 3 2 0}
{define: Em base-fret 1 frets 0 4 0 2}
{define: C base-fret 1 frets 0 0 0 3}
{define: D7 base-fret 1 frets 2 2 2 3}
{define: B7aug9 base-fret 2 frets 1 2 1 4}
{define: Am6 base-fret 1 frets 2 0 2 0}
{define: F#7 base-fret 1 frets 3 4 2 4}
{define: E7 base-fret 1 frets 1 2 0 2}
{define: C#dim7 base-fret 1 frets 0 1 0 1}

[G]· · ·

{start_of_verse: Intro}
[Am]·  · · · · · | [B7]·  · · · · · | [Em]·  · · · · · | [Em]·  · · · · ·
[C]· · · · · · | [D7]·  · · · · · | [G]↓ [B7] · · · · | [B7aug9]↓      [B7aug9]↓      [B7] · · ·
