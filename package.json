{
  "name": "ukulele-veneco-app",
  "version": "1.1.0",
  "description": "A Next.js application for displaying Venezuelan ukulele songs with chord diagrams and lyrics. Based on the song collection by Ciro Durán from https://elukulelevene.co",
  "license": "CC-BY-NC-4.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check --write",
    "format": "biome format --write",
    "validate": "node scripts/validate-songs.mjs",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "idb": "^8.0.3",
    "lottie-react": "^2.4.1",
    "next": "16.0.10",
    "next-pwa": "^5.6.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.170",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
