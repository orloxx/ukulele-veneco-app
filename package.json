{
  "name": "ukulele-veneco-app",
  "version": "2.10.0",
  "description": "A Next.js application for displaying Venezuelan ukulele songs with chord diagrams and lyrics. Based on the song collection by Ciro Durán from https://elukulelevene.co",
  "license": "CC-BY-NC-4.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-videos.mjs && next build --webpack && serwist build serwist.config.mjs && node scripts/check-credits.mjs",
    "start": "next start",
    "lint": "biome check --write",
    "format": "biome format --write",
    "validate": "node scripts/validate-songs.mjs",
    "credits": "node scripts/check-credits.mjs",
    "clean": "rm -rf .next node_modules public/sw.js public/sw.js.map",
    "transpose": "node scripts/check-transpose.mjs",
    "difficulty": "node scripts/check-difficulty.mjs",
    "videos": "node scripts/check-videos.mjs"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "gray-matter": "^4.0.3",
    "idb": "^8.0.3",
    "next": "16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "serwist": "^9.5.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.170",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
