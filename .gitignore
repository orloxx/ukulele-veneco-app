# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The source cancionero left at M6 and nothing here reads a PDF any more. The rule stays
# anyway, because it was never about the extractor: public/ is served verbatim, so a
# tracked copy hands the whole book out at a guessable URL, and on a public repo the
# history would keep doing it long after the file was deleted. That is a fact about
# public/, so it outlives the tool. The book is at https://elukulelevene.co; if you want a
# copy, keep it outside the working tree.
/public/*.pdf

# PWA files
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map

# IDE
.idea/
.vscode/
